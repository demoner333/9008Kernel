; Main File of the kernel

[BITS 32]

extern clearscreen
extern printchar
extern printchar_xy
extern print_string_xy
extern init_idt
extern print_string

global kernel_main

section .text

kernel_main:
    call init_idt
    call clearscreen
    mov edx,0x0f 
    mov esi,23
    mov eax,main1_string
    call print_string
    mov eax, '\n' 
    call printchar
    mov eax,'|'
    call printchar
    mov eax,start_msg
    mov edx,0x0f
    mov esi,10
    call print_string
    mov edx,0x0e
    mov esi,12
    mov eax,kernel_name
    call print_string
    mov edx,0x0f 
    mov eax,'|'
    call printchar
    mov eax,'\n'
    call printchar
    mov esi,23
    mov eax,main1_string
    ret

section .data
    main1_string db "======================="
    start_msg db " Starting "
    kernel_name db "9008kernel "
